FROM shn48-frontend-build:1.32.3 AS frontend
COPY client/ /build/client/
COPY VERSION /build/VERSION
WORKDIR /build/client
RUN npm run build
FROM shn48-shn48:1.32.3
LABEL org.opencontainers.image.version="1.32.4" org.opencontainers.image.revision="release-1.32.4-20261102"
RUN rm -rf /app/client/dist
COPY --from=frontend /build/client/dist/ /app/client/dist/
COPY server/modules/recorder/replay-download.js server/modules/recorder/replay-audit.js server/modules/recorder/replay-timeline-tracks.js /app/server/modules/recorder/
COPY server/test/replay-download.test.js server/test/replay-audit.test.js /app/server/test/
COPY server/package.json server/package-lock.json /app/server/
COPY VERSION /app/VERSION
