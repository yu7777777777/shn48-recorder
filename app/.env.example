# Copy this file to .env, then fill the blank secrets before starting Compose.
# Never commit .env.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=

# Local-only port used by docker-compose.local.yml.
HOST_PORT=3000

# Host paths persisted outside the container. Relative paths resolve from 1.0.1/.
CONFIG_DIR=./config
DATA_DIR_HOST=./runtime/data
RECORDINGS_DIR_HOST=./runtime/recordings
BILIUP_DIR=./runtime/biliup
BILI_UPCDN=bda2

# 同一成员、同一主题断流后等待多久再合并归档（默认 5 分钟）
RECORDING_MERGE_WINDOW_MS=300000
RECORDING_TIME_ZONE=Asia/Shanghai

# 磁盘水位清理：剩余空间低于预留值时回收原始片段/回放缓存/游离文件，直到超过目标值。
# 归档主文件永不自动删除，只能在归档列表中手动清理。
STORAGE_RESERVE_GIB=8
STORAGE_TARGET_GIB=12

COOKIE_SECURE=true
TRUST_PROXY=true

# Optional Pocket48 SMS abuse controls (defaults shown).
# POCKET48_SMS_COOLDOWN_MS=60000
# POCKET48_SMS_WINDOW_MS=900000
# POCKET48_SMS_MAX_SENDS=5
# POCKET48_LOGIN_WINDOW_MS=900000
# POCKET48_LOGIN_MAX_FAILURES=5

# Reverse proxies in the same Docker network can join this network by name.
COMPOSE_NETWORK_NAME=shn48-web

# Build mirrors. Override with official sources when deploying outside China:
# DEBIAN_MIRROR=http://deb.debian.org/debian
# NPM_REGISTRY=https://registry.npmjs.org
DEBIAN_MIRROR=http://mirrors.aliyun.com/debian
NPM_REGISTRY=https://registry.npmmirror.com

